{
  "name": "moirasia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Moirasia desktop shell",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm native:bridge:build && pnpm build:app",
    "build:app": "electron-vite build",
    "native:bridge:build": "node scripts/build-native-view-bridge.mjs",
    "test:native-view-gate": "electron scripts/native-view-gate.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.react.json --noEmit",
    "test": "vitest run",
    "test:ownership": "node scripts/check-root-ownership.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dist:mac": "pnpm build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "@moirasia/module-sdk": "file:packages/module-sdk",
    "@moirasia/ui-css": "file:packages/ui-css",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "43.1.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
