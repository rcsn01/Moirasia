{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "lib": ["ES2022"]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "packages/desktop-shell/src/**/*.ts",
    "apps/Amove/src/main/**/*.ts",
    "apps/Amove/src/preload/**/*.ts",
    "apps/Amove/src/shared/**/*.ts",
    "apps/Exithibition/src/main/**/*.ts",
    "apps/Exithibition/src/preload/**/*.ts",
    "apps/Exithibition/src/shared/**/*.ts",
    "apps/Orbis/src/main/**/*.ts",
    "apps/Orbis/src/preload/**/*.ts",
    "apps/Orbis/src/shared/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["apps/**/*.test.ts", "apps/**/*.test.tsx"]
}
